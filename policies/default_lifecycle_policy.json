{
  "rules": [
    {
      "rulePriority": 10,
      "description": "Never expire the latest tag",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": ["latest"],
        "countType": "imageCountMoreThan",
        "countNumber": 9999
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 20,
      "description": "Keep latest 50 semver tags before archiving them",
      "selection": {
        "tagStatus": "tagged",
        "tagPatternList": ["*.*.*", "v*.*.*"],
        "countType": "imageCountMoreThan",
        "countNumber": 50
      },
      "action": {
        "type": "transition",
        "targetStorageClass": "archive"
      }
    },
    {
      "rulePriority": 30,
      "description": "Archive all other artefacts if they haven't been pulled in 60 days",
      "selection": {
        "tagStatus": "any",
        "countType": "sinceImagePulled",
        "countUnit": "days",
        "countNumber": 60
      },
      "action": {
        "type": "transition",
        "targetStorageClass": "archive"
      }
    },
    {
      "rulePriority": 40,
      "description": "Expire archived untagged artefacts not referenced by an manifest list after 90 days",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImageTransitioned",
        "countUnit": "days",
        "countNumber": 90,
        "storageClass": "archive"
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 50,
      "description": "Expire tags archived for more than 365 days",
      "selection": {
        "tagStatus": "any",
        "countType": "sinceImageTransitioned",
        "countUnit": "days",
        "countNumber": 365,
        "storageClass": "archive"
      },
      "action": {
        "type": "expire"
      }
    }
  ]
}
